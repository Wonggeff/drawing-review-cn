# 0*_各专业问题明细清单.md
# 0*_图纸会审记录表.xlsx
# 0*_图纸会审记录表.docx

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

